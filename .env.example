# Copy to .env.local and fill in only what you use. Never commit .env.local.
# Everything below is optional: with no file at all the app runs fully local and free.

# Timezone for new schedules (IANA name). Defaults to the system timezone.
# ACC_TIMEZONE=Europe/Paris

# --- Local LLM (default; must be a localhost URL) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=ministral-3:3b

# --- Optional showcase: MongoDB Atlas (free M0 tier) ---
# ATLAS_ENABLED=false
# Use a dedicated database user limited to readWrite on ATLAS_DB_NAME only.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# ATLAS_DB_NAME=agent_command_center

# --- Optional showcase: Voyage AI (free token allowance) ---
# VOYAGE_ENABLED=false
# VOYAGE_API_KEY=<your-voyage-api-key>
# VOYAGE_EMBED_MODEL=voyage-4-lite
# VOYAGE_RERANK_MODEL=rerank-3-lite
# VOYAGE_DIMENSIONS=512
# Voyage limits accounts without a payment method to 3 requests/min; the app paces itself to this.
# VOYAGE_MAX_RPM=3

# --- Optional: local MCP server (stdio). Generate with: openssl rand -hex 24 ---
# MCP_TOKEN=<at-least-24-random-characters>

# --- Optional: read-only Google connectors (see docs/GOOGLE_SETUP.md) ---
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-client-secret>
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/google/callback
